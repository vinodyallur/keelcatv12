# ── Public address (Caddy) ───────────────────────────────────
# Local test:  :80      Production:  your domain (enables auto-HTTPS)
SITE_ADDRESS=:80

# ── Authentication — pick ONE mode ───────────────────────────
#
# MODE 1 (SaaS / multi-user): "Log in with GitHub". Each user gets their own
# isolated workspace (repos, connections, runs). Create an OAuth App at
#   https://github.com/settings/developers  →  New OAuth App
#     Homepage URL:  https://<your-domain>
#     Callback URL:  https://<your-domain>/api/auth/callback
# then set both values below. SESSION_SECRET signs the login cookie — set a long
# random string (e.g. `openssl rand -hex 32`) so sessions survive restarts.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SESSION_SECRET=

# Also offer "Log in with Google" (optional, works alongside GitHub). Create an
# OAuth client at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorized redirect URI:  https://<your-domain>/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: let YOUR login inherit the existing (pre-multi-tenant) data instead
# of starting an empty workspace. Set the GitHub username and/or Google email.
OWNER_GITHUB_LOGIN=
OWNER_GOOGLE_EMAIL=

# Guest mode: a "just try it" button — enter a name, get a temporary isolated
# workspace tied to the browser cookie (no credentials). On by default; set to
# "off" to disable (e.g. once you no longer want anonymous access).
GUEST_MODE=on

# MODE 2 (single shared operator): leave the OAuth values blank and set this to
# require one shared HTTP Basic password instead. Everyone shares ONE workspace.
# If both OAuth and APP_PASSWORD are set, OAuth wins. Leave everything blank to
# run fully open (trusted demo only). /api/health and /api/webhook/* are always
# exempt from the gate.
APP_PASSWORD=

# ── GitHub — choose PAT (simplest) OR the GitHub App ──────────
# Personal Access Token (repo scope). Easiest for one operator.
GITHUB_PAT=

# GitHub App (needed for the install + webhook flow). Provide the PEM as
# base64 (single line, no newlines to escape):
#   Linux/mac:  base64 -w0 app-private-key.pem
#   Windows:    [Convert]::ToBase64String([IO.File]::ReadAllBytes("app.pem"))
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=

# ── Billing (Razorpay) ───────────────────────────────────────
# Each workspace gets FREE_RUN_LIMIT free runs, then must upgrade. Get API keys
# from the Razorpay dashboard (Test keys work end-to-end for trials). The
# publishable KEY_ID is exposed to the browser via the order response; the
# KEY_SECRET stays server-side only (used for signature verification).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Per-interval premium prices, in rupees. PREMIUM_PRICE_INR is the legacy single
# price and is still honored as the monthly fallback.
PREMIUM_PRICE_MONTHLY_INR=999
PREMIUM_PRICE_ANNUAL_INR=9990
PREMIUM_PRICE_INR=999
FREE_RUN_LIMIT=10
# Optional but recommended: the secret you set on the Razorpay webhook
# (Settings → Webhooks) pointing at POST /api/billing/webhook. Enables reliable
# server-to-server upgrade confirmation even if the browser never returns.
RAZORPAY_WEBHOOK_SECRET=

# ── LLM (OpenRouter / Google Gemini / any OpenAI-compatible) ──
LLM_API_KEY=

# ── Notifications (optional) ──────────────────────────────────
SMTP_PASS=
SLACK_WEBHOOK_URL=

# NOTE: These env values only seed secrets on a FRESH volume. Once you save
# anything through the UI, the persisted data/ store takes over.
